rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'rajagaming199@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidStringList(listVal, maxLen) {
      return listVal is list
        && listVal.size() <= maxLen
        && (listVal.size() == 0 || listVal[0] is string);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && data.updatedAt is timestamp;
    }

    function isValidFavorite(data, userId) {
      return data.keys().hasAll(['uid', 'itemId', 'tipeItem', 'tanggalDitambahkan', 'createdAt'])
        && data.keys().hasOnly(['uid', 'itemId', 'tipeItem', 'tanggalDitambahkan', 'createdAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.itemId is string
        && data.itemId.size() >= 1
        && data.itemId.size() <= 128
        && data.itemId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.tipeItem is string
        && data.tipeItem in ['destinasi', 'kuliner']
        && data.tanggalDitambahkan is string
        && data.tanggalDitambahkan.size() >= 10
        && data.tanggalDitambahkan.size() <= 40
        && data.createdAt is timestamp;
    }

    function isValidItinerary(data, userId) {
      return data.keys().hasAll([
          'uid',
          'namaPerjalanan',
          'tanggalMulai',
          'jumlahHari',
          'jumlahWisatawan',
          'daftarAktivitas',
          'totalAnggaran',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'namaPerjalanan',
          'tanggalMulai',
          'jumlahHari',
          'jumlahWisatawan',
          'daftarAktivitas',
          'totalAnggaran',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.namaPerjalanan is string
        && data.namaPerjalanan.size() >= 1
        && data.namaPerjalanan.size() <= 120
        && data.tanggalMulai is string
        && data.tanggalMulai.size() <= 20
        && data.jumlahHari is number
        && data.jumlahHari >= 1
        && data.jumlahHari <= 5
        && data.jumlahWisatawan is number
        && data.jumlahWisatawan >= 1
        && data.jumlahWisatawan <= 100
        && data.daftarAktivitas is list
        && data.daftarAktivitas.size() <= 50
        && (data.daftarAktivitas.size() == 0 || data.daftarAktivitas[0] is map)
        && data.totalAnggaran is number
        && data.totalAnggaran >= 0
        && data.totalAnggaran <= 1000000000
        && data.createdBy is string
        && data.createdBy.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDestination(data, itemId) {
      return data.keys().hasAll([
          'id',
          'nama',
          'kategori',
          'wilayah',
          'deskripsi',
          'imageUrl',
          'alamat',
          'mapsUrl',
          'estimasiBiaya',
          'fasilitas',
          'fasilitasIbadah',
          'unggulan',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'nama',
          'kategori',
          'wilayah',
          'deskripsi',
          'imageUrl',
          'imageData',
          'alamat',
          'mapsUrl',
          'estimasiBiaya',
          'fasilitas',
          'fasilitasIbadah',
          'unggulan',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.kategori is string && data.kategori.size() >= 1 && data.kategori.size() <= 60
        && data.wilayah is string && data.wilayah.size() >= 1 && data.wilayah.size() <= 80
        && data.deskripsi is string && data.deskripsi.size() <= 2000
        && data.imageUrl is string && data.imageUrl.size() <= 512
        && (!('imageData' in data) || (data.imageData is string && data.imageData.size() <= 750000))
        && data.alamat is string && data.alamat.size() <= 300
        && data.mapsUrl is string && data.mapsUrl.size() <= 512
        && data.estimasiBiaya is number && data.estimasiBiaya >= 0 && data.estimasiBiaya <= 1000000000
        && isValidStringList(data.fasilitas, 30)
        && isValidStringList(data.fasilitasIbadah, 30)
        && data.unggulan is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFood(data, itemId) {
      return data.keys().hasAll([
          'id',
          'nama',
          'kategori',
          'wilayah',
          'harga',
          'imageUrl',
          'statusSertifikasiHalal',
          'sumberVerifikasi',
          'kontak',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'nama',
          'kategori',
          'wilayah',
          'harga',
          'imageUrl',
          'imageData',
          'statusSertifikasiHalal',
          'sumberVerifikasi',
          'kontak',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.kategori is string && data.kategori.size() >= 1 && data.kategori.size() <= 60
        && data.wilayah is string && data.wilayah.size() >= 1 && data.wilayah.size() <= 80
        && data.harga is number && data.harga >= 0 && data.harga <= 1000000000
        && data.imageUrl is string && data.imageUrl.size() <= 512
        && (!('imageData' in data) || (data.imageData is string && data.imageData.size() <= 750000))
        && data.statusSertifikasiHalal is string && data.statusSertifikasiHalal.size() <= 120
        && data.sumberVerifikasi is string && data.sumberVerifikasi.size() <= 250
        && data.kontak is string && data.kontak.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStay(data, itemId) {
      return data.keys().hasAll([
          'id',
          'nama',
          'wilayah',
          'hargaPerMalam',
          'fasilitas',
          'fasilitasRamahMuslim',
          'imageUrl',
          'kontak',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'nama',
          'wilayah',
          'hargaPerMalam',
          'fasilitas',
          'fasilitasRamahMuslim',
          'imageUrl',
          'imageData',
          'kontak',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.wilayah is string && data.wilayah.size() >= 1 && data.wilayah.size() <= 80
        && data.hargaPerMalam is number && data.hargaPerMalam >= 0 && data.hargaPerMalam <= 1000000000
        && isValidStringList(data.fasilitas, 30)
        && isValidStringList(data.fasilitasRamahMuslim, 30)
        && data.imageUrl is string && data.imageUrl.size() <= 512
        && (!('imageData' in data) || (data.imageData is string && data.imageData.size() <= 750000))
        && data.kontak is string && data.kontak.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPackage(data, itemId) {
      return data.keys().hasAll([
          'id',
          'nama',
          'durasi',
          'daftarDestinasi',
          'estimasiBiaya',
          'deskripsi',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'nama',
          'durasi',
          'daftarDestinasi',
          'estimasiBiaya',
          'deskripsi',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == itemId
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.durasi is number && data.durasi >= 1 && data.durasi <= 30
        && isValidStringList(data.daftarDestinasi, 30)
        && data.estimasiBiaya is number && data.estimasiBiaya >= 0 && data.estimasiBiaya <= 1000000000
        && data.deskripsi is string && data.deskripsi.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogMeta(data) {
      return data.keys().hasAll(['seeded', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['seeded', 'updatedBy', 'updatedAt'])
        && data.seeded is bool
        && data.updatedBy is string && data.updatedBy.size() <= 254
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isEmailVerified()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      match /favorites/{favId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(favId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isEmailVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(favId)
          && isValidFavorite(incoming(), userId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false;
        allow delete: if isEmailVerified() && isOwner(userId) && isValidId(userId) && isValidId(favId);
      }

      match /itineraries/{tripId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(tripId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;
        allow create: if isEmailVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(tripId)
          && isValidItinerary(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isEmailVerified()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(tripId)
          && isValidItinerary(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'namaPerjalanan',
            'tanggalMulai',
            'jumlahHari',
            'jumlahWisatawan',
            'daftarAktivitas',
            'totalAnggaran',
            'updatedAt'
          ]);
        allow delete: if isEmailVerified() && isOwner(userId) && isValidId(userId) && isValidId(tripId);
      }
    }

    match /destinations/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.id is string;
      allow create: if isAdmin()
        && isValidId(itemId)
        && isValidDestination(incoming(), itemId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(itemId)
        && isValidDestination(incoming(), itemId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nama',
          'kategori',
          'wilayah',
          'deskripsi',
          'imageUrl',
          'imageData',
          'alamat',
          'mapsUrl',
          'estimasiBiaya',
          'fasilitas',
          'fasilitasIbadah',
          'unggulan',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /foods/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.id is string;
      allow create: if isAdmin()
        && isValidId(itemId)
        && isValidFood(incoming(), itemId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(itemId)
        && isValidFood(incoming(), itemId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nama',
          'kategori',
          'wilayah',
          'harga',
          'imageUrl',
          'imageData',
          'statusSertifikasiHalal',
          'sumberVerifikasi',
          'kontak',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /stays/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.id is string;
      allow create: if isAdmin()
        && isValidId(itemId)
        && isValidStay(incoming(), itemId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(itemId)
        && isValidStay(incoming(), itemId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nama',
          'wilayah',
          'hargaPerMalam',
          'fasilitas',
          'fasilitasRamahMuslim',
          'imageUrl',
          'imageData',
          'kontak',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /packages/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.id is string;
      allow create: if isAdmin()
        && isValidId(itemId)
        && isValidPackage(incoming(), itemId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(itemId)
        && isValidPackage(incoming(), itemId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nama',
          'durasi',
          'daftarDestinasi',
          'estimasiBiaya',
          'deskripsi',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /catalogMeta/{metaId} {
      allow get: if isValidId(metaId);
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(metaId)
        && isValidCatalogMeta(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(metaId)
        && isValidCatalogMeta(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['seeded', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }
  }
}
