{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated Google user profile stored privately under the user's own document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google account email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name from Google account."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 512,
          "description": "Optional avatar URL from Google account."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile sync."
        }
      },
      "required": ["uid", "email", "displayName", "updatedAt"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "A user's saved favorite destination or culinary item.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Catalog ID of the favorited destination or food item."
        },
        "tipeItem": {
          "type": "string",
          "enum": ["destinasi", "kuliner"],
          "description": "Item category."
        },
        "tanggalDitambahkan": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "ISO timestamp when favorite was added."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when favorite was created."
        }
      },
      "required": ["uid", "itemId", "tipeItem", "tanggalDitambahkan", "createdAt"]
    },
    "Itinerary": {
      "title": "Itinerary",
      "description": "A user's saved Aceh travel itinerary and estimated budget.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "namaPerjalanan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Trip title."
        },
        "tanggalMulai": {
          "type": "string",
          "maxLength": 20,
          "description": "Planned start date (YYYY-MM-DD or empty)."
        },
        "jumlahHari": {
          "type": "number",
          "description": "Number of trip days (1-5)."
        },
        "jumlahWisatawan": {
          "type": "number",
          "description": "Number of travellers (1-100)."
        },
        "daftarAktivitas": {
          "type": "array",
          "description": "Bounded list of planned destination activities (max 50)."
        },
        "totalAnggaran": {
          "type": "number",
          "description": "Calculated estimated trip budget in IDR."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 254,
          "description": "Email of creator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "uid",
        "namaPerjalanan",
        "tanggalMulai",
        "jumlahHari",
        "jumlahWisatawan",
        "daftarAktivitas",
        "totalAnggaran",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Destination": {
      "title": "Destination",
      "description": "Public tourist destination in Aceh managed from the admin dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kategori": { "type": "string", "minLength": 1, "maxLength": 60 },
        "wilayah": { "type": "string", "minLength": 1, "maxLength": 80 },
        "deskripsi": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 512 },
        "imageData": { "type": "string", "maxLength": 750000 },
        "alamat": { "type": "string", "maxLength": 300 },
        "mapsUrl": { "type": "string", "maxLength": 512 },
        "estimasiBiaya": { "type": "number" },
        "fasilitas": { "type": "array" },
        "fasilitasIbadah": { "type": "array" },
        "unggulan": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "nama",
        "kategori",
        "wilayah",
        "deskripsi",
        "imageUrl",
        "alamat",
        "mapsUrl",
        "estimasiBiaya",
        "fasilitas",
        "fasilitasIbadah",
        "unggulan",
        "createdAt",
        "updatedAt"
      ]
    },
    "FoodItem": {
      "title": "FoodItem",
      "description": "Public culinary or MSME catalog entry managed from the admin dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kategori": { "type": "string", "minLength": 1, "maxLength": 60 },
        "wilayah": { "type": "string", "minLength": 1, "maxLength": 80 },
        "harga": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 512 },
        "imageData": { "type": "string", "maxLength": 750000 },
        "statusSertifikasiHalal": { "type": "string", "maxLength": 120 },
        "sumberVerifikasi": { "type": "string", "maxLength": 250 },
        "kontak": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "nama",
        "kategori",
        "wilayah",
        "harga",
        "imageUrl",
        "statusSertifikasiHalal",
        "sumberVerifikasi",
        "kontak",
        "createdAt",
        "updatedAt"
      ]
    },
    "StayItem": {
      "title": "StayItem",
      "description": "Public Muslim-friendly accommodation entry managed from the admin dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": { "type": "string", "minLength": 1, "maxLength": 120 },
        "wilayah": { "type": "string", "minLength": 1, "maxLength": 80 },
        "hargaPerMalam": { "type": "number" },
        "fasilitas": { "type": "array" },
        "fasilitasRamahMuslim": { "type": "array" },
        "imageUrl": { "type": "string", "maxLength": 512 },
        "imageData": { "type": "string", "maxLength": 750000 },
        "kontak": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "nama",
        "wilayah",
        "hargaPerMalam",
        "fasilitas",
        "fasilitasRamahMuslim",
        "imageUrl",
        "kontak",
        "createdAt",
        "updatedAt"
      ]
    },
    "PackageItem": {
      "title": "PackageItem",
      "description": "Public curated tour package managed from the admin dashboard.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": { "type": "string", "minLength": 1, "maxLength": 120 },
        "durasi": { "type": "number" },
        "daftarDestinasi": { "type": "array" },
        "estimasiBiaya": { "type": "number" },
        "deskripsi": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "nama",
        "durasi",
        "daftarDestinasi",
        "estimasiBiaya",
        "deskripsi",
        "createdAt",
        "updatedAt"
      ]
    },
    "CatalogMeta": {
      "title": "CatalogMeta",
      "description": "Tracks whether default seed catalog items have been initialized in Firestore.",
      "type": "object",
      "properties": {
        "seeded": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 254 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["seeded", "updatedBy", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile document owned by userId."
    },
    "/users/{userId}/favorites/{favId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "User's favorite destinations and culinary items."
    },
    "/users/{userId}/itineraries/{tripId}": {
      "schema": { "$ref": "#/entities/Itinerary" },
      "description": "User's saved trip itineraries."
    },
    "/destinations/{itemId}": {
      "schema": { "$ref": "#/entities/Destination" },
      "description": "Publicly readable destinations catalog writable only by verified admins."
    },
    "/foods/{itemId}": {
      "schema": { "$ref": "#/entities/FoodItem" },
      "description": "Publicly readable culinary & MSMEs catalog writable only by verified admins."
    },
    "/stays/{itemId}": {
      "schema": { "$ref": "#/entities/StayItem" },
      "description": "Publicly readable accommodations catalog writable only by verified admins."
    },
    "/packages/{itemId}": {
      "schema": { "$ref": "#/entities/PackageItem" },
      "description": "Publicly readable tour packages catalog writable only by verified admins."
    },
    "/catalogMeta/{metaId}": {
      "schema": { "$ref": "#/entities/CatalogMeta" },
      "description": "Catalog initialization metadata writable only by verified admins."
    }
  }
}
